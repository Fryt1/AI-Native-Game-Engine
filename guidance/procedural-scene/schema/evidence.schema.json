{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native.local/schema/evidence.json",
  "title": "Scene generation evidence",
  "description": "The record an Agent returns for one scene generation. A check that reads a field this schema does not declare is a check against a shape nobody promised.",

  "type": "object",
  "required": ["scene_id", "stage", "measurements"],
  "additionalProperties": false,
  "properties": {
    "scene_id": {"type": "string", "minLength": 1},
    "stage": {
      "enum": ["host_probe", "generate", "mesh_integrity", "environment", "render"]
    },
    "seed": {"type": ["integer", "null"]},
    "measurements": {"$ref": "#/$defs/measurements"},
    "scan_coverage": {
      "type": ["object", "null"],
      "description": "A bounded scan must state how much it covered, so partial coverage is never presented as complete.",
      "required": ["analysed", "total"],
      "additionalProperties": false,
      "properties": {
        "analysed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "unit": {"type": "string"}
      }
    },
    "needs_human": {
      "type": "array",
      "description": "Judgements no deterministic check can settle. Recorded rather than disguised as a threshold.",
      "items": {"type": "string"}
    }
  },

  "$defs": {
    "measurements": {
      "type": "object",
      "description": "Values read back from the host, never taken from a generator's self-report.",
      "additionalProperties": false,
      "properties": {
        "total_triangles": {"type": "integer", "minimum": 0},
        "city_objects": {"type": "integer", "minimum": 0},
        "distinct_materials_used": {"type": "integer", "minimum": 0},
        "no_degenerate_faces": {"type": "boolean"},
        "no_geometry_below_ground": {"type": "boolean"},
        "has_all_groups": {"type": "boolean"},
        "meets_coplanar_budget": {"type": "boolean"},
        "coplanar_overlaps": {"type": "integer", "minimum": 0},
        "camera_exists": {"type": "boolean"},
        "blend_bytes": {"type": "integer", "minimum": 0},
        "hero_width": {"type": "integer", "minimum": 0},
        "all_exist": {"type": "boolean"},
        "no_blank_frames": {"type": "boolean"}
      }
    }
  }
}
