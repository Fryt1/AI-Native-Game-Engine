# --- Python / build ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
dist/
build/
*.egg-info/
*.pyc

# --- Local env / editors ---
.env
.vscode/
.idea/

# --- Scratch: commit-message files, since PowerShell has no heredoc ---
_*.txt
_*.py

# --- Artifacts: keep only README/.gitkeep placeholders, ignore generated data ---
artifacts/*
!artifacts/README.md
!artifacts/**/README.md
!artifacts/**/.gitkeep
artifacts/evidence/*
!artifacts/evidence/README.md
artifacts/exports/*
!artifacts/exports/README.md
!artifacts/exports/.gitkeep
artifacts/manifests/*
!artifacts/manifests/README.md
!artifacts/manifests/.gitkeep
artifacts/runs/*
!artifacts/runs/.gitkeep
artifacts/session-reports/
artifacts/scratch/*
!artifacts/scratch/.gitkeep

# --- uv (not used; pyproject/pip is the dependency workflow) ---
uv.lock

# --- Installed skill: a build output, refreshed by install_skill.py ---
.agents/
