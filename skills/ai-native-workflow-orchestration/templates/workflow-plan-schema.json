{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ainative.local/schema/workflow-plan.json",
  "title": "AI Native Agent WorkflowPlan",
  "type": "object",
  "required": [
    "workflow",
    "modification_method",
    "host_app"
  ],
  "properties": {
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "transfer_backend": {
      "type": [
        "string",
        "null"
      ]
    },
    "blender_call_surface": {
      "type": [
        "string",
        "null"
      ]
    },
    "modification_method": {
      "type": "string",
      "minLength": 1
    },
    "host_app": {
      "type": "string",
      "minLength": 1
    },
    "host_call_surface": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "workflow": {
      "type": "object",
      "required": [
        "workflow_id",
        "route",
        "profile",
        "authority_id",
        "plan_id",
        "revision",
        "steps"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "enum": [
            "host_operation",
            "asset_transfer",
            "artifact_pipeline"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "feasible",
            "running",
            "suspended",
            "completed",
            "failed",
            "invalid",
            "superseded"
          ]
        },
        "supersedes_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "replan_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "validation_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "step_id",
        "purpose",
        "stages"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": [
        "stage_id",
        "stage_kind",
        "purpose",
        "execution_checklist",
        "acceptance_checklist",
        "calls",
        "required"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "stage_kind": {
          "enum": [
            "change",
            "investigation",
            "planning"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string"
        },
        "execution_checklist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionItem"
          }
        },
        "acceptance_checklist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptanceCheck"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "input_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "output_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "recovery": {
          "type": [
            "string",
            "null"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/toolCall"
              },
              {
                "$ref": "#/$defs/mcpCall"
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "properties": {
              "execution_checklist": {
                "minItems": 1
              },
              "acceptance_checklist": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "executionItem": {
      "type": "object",
      "required": [
        "item_id",
        "description",
        "required",
        "call_ids",
        "evidence_required"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "evidence_required": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        },
        "call_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "acceptanceCheck": {
      "type": "object",
      "required": [
        "check_id",
        "description",
        "required",
        "call_ids",
        "operator",
        "evidence_required"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "source_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operator": {
          "enum": [
            "manual",
            "tool_succeeded",
            "exists",
            "truthy",
            "equals",
            "set_equals",
            "count_equals",
            "within_tolerance"
          ]
        },
        "expected": {},
        "tolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "evidence_required": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        },
        "call_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "toolCall": {
      "type": "object",
      "required": [
        "kind",
        "call_id",
        "toolset_id",
        "tool_id",
        "arguments",
        "depends_on",
        "usage"
      ],
      "properties": {
        "kind": {
          "const": "tool"
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "toolset_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "usage": {
          "enum": [
            "execute",
            "observe",
            "verify",
            "report"
          ]
        }
      },
      "additionalProperties": false
    },
    "mcpCall": {
      "type": "object",
      "required": [
        "kind",
        "call_id",
        "server_id",
        "tool_name",
        "arguments",
        "depends_on",
        "usage"
      ],
      "properties": {
        "kind": {
          "const": "mcp"
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "server_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "usage": {
          "enum": [
            "execute",
            "observe",
            "verify",
            "report"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
